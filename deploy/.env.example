# Copy to deploy/.env and fill in. Never commit .env.

# Your domain. The stack serves it, www, app. and demo. subdomains.
SITE_DOMAIN=grc-flow.com

# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=talk@grc-flow.com

# Enables the GRC Analyst and AI drafting in the real workspace (app.).
# Get one at https://console.anthropic.com and set a monthly spend limit there.
ANTHROPIC_API_KEY=

# Where to build the GRC agent app from. Default: the GitHub repo's main branch.
# GRC_AI_CONTEXT=../../GRC-Ai

# Testing only: extra Caddy global options, e.g. "local_certs" for self-signed certificates.
# CADDY_GLOBAL_OPTIONS=
