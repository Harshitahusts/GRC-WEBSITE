# Caddy gets and renews Let's Encrypt certificates for every site below,
# as long as DNS points at this server and ports 80 and 443 are open.
{
	email {$ACME_EMAIL}
	{$CADDY_GLOBAL_OPTIONS}
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

# Website. www redirects to the bare domain.
{$SITE_DOMAIN}, www.{$SITE_DOMAIN} {
	import common
	@www host www.{$SITE_DOMAIN}
	redir @www https://{$SITE_DOMAIN}{uri} permanent
	header X-Frame-Options "DENY"
	reverse_proxy website:3000
}

# The real GRC agent workspace. Never shown inside another site.
app.{$SITE_DOMAIN} {
	import common
	header {
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
	}
	reverse_proxy app:8000
}

# Demo workspace, embedded only by the website's /demo page.
demo.{$SITE_DOMAIN} {
	import common
	header Content-Security-Policy "frame-ancestors https://{$SITE_DOMAIN} https://www.{$SITE_DOMAIN}"
	reverse_proxy demo:8001
}
